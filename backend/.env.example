# Environment variables for Green Mobility Backend
PORT=8080
CONTEXT_PATH=/api/v1

# PostgreSQL + PostGIS (Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=greenmobility_db
DB_USER=green_admin
DB_PASSWORD=green_password_2026

# Redis (Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB (Docker Compose)
MONGO_URI=mongodb://mongo_admin:mongo_password_2026@localhost:27017/greenmobility_telemetry?authSource=admin

# RabbitMQ (Docker Compose)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbit_admin
RABBITMQ_PASSWORD=rabbit_password_2026

# MinIO S3 Local (Docker Compose)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password_2026
S3_BUCKET_NAME=greenmobility-assets

# Security & JWT (Generate a 256-bit key using: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_secure_256_bit_hex_secret_key_in_production
JWT_EXPIRATION_SECONDS=86400

# Payment Sandboxes
VNPAY_TMN_CODE=SANDBOX_TMN_CODE
VNPAY_HASH_SECRET=SANDBOX_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=MOMO_SANDBOX_PARTNER
MOMO_ACCESS_KEY=MOMO_SANDBOX_ACCESS_KEY
MOMO_SECRET_KEY=MOMO_SANDBOX_SECRET_KEY
